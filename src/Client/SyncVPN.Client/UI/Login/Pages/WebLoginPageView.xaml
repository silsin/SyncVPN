<Page x:Class="SyncVPN.Client.UI.Login.Pages.WebLoginPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="WebLoginPage"
      AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Login_WebLoginForm_Title')}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Grid VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,32"
                    Spacing="8">
            <TextBlock Foreground="{ThemeResource TextNormColorBrush}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.Localizer.Get('Login_WebLoginForm_Title')}" />
            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Text="{x:Bind ViewModel.Localizer.Get('Login_WebLoginForm_Subtitle')}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Spacing="16">
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="OpenBrowserSignInButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('SignIn_Form_SignIn')}"
                    Command="{x:Bind ViewModel.OpenBrowserSignInCommand, Mode=OneTime}"
                    Content="{x:Bind ViewModel.Localizer.Get('SignIn_Form_SignIn')}"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="LoginWithCodeButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('SignIn_Form_LoginWithCode')}"
                    Command="{x:Bind ViewModel.NavigateToCodeLoginCommand, Mode=OneTime}"
                    Content="{x:Bind ViewModel.Localizer.Get('SignIn_Form_LoginWithCode')}"
                    Foreground="{ThemeResource TextNormColorBrush}"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

    </Grid>

</Page>
