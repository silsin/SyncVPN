<Page x:Class="SyncVPN.Client.UI.Login.Pages.CodeLoginPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:attachedProperties="using:SyncVPN.Client.Common.UI.AttachedProperties"
      xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pathIcons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="CodeLoginPage"
      AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_Title')}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Grid VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <custom:GhostButton Grid.Row="0"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.GoBackCommand, Mode=OneTime}"
                            Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Back')}">
            <custom:GhostButton.LeftIcon>
                <pathIcons:ArrowLeft />
            </custom:GhostButton.LeftIcon>
        </custom:GhostButton>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,32"
                    Spacing="8">
            <TextBlock Foreground="{ThemeResource TextNormColorBrush}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_Title')}" />
            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Text="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_Subtitle')}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Spacing="16">

            <TextBox x:Name="CodeTextBox"
                     attachedProperties:FieldValidation.ErrorMessage="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_CodeError')}"
                     attachedProperties:FieldValidation.HasErrors="{x:Bind ViewModel.IsToShowError}"
                     AutomationProperties.AutomationId="CodeTextBox"
                     Header="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_Placeholder')}"
                     IsEnabled="{x:Bind ViewModel.IsFormEnabled}"
                     IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False"
                     KeyDown="OnCodeBoxKeyDown"
                     MaxLength="16"
                     Style="{StaticResource ValidationTextBoxStyle}"
                     Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="SignInWithCodeButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_Continue')}"
                    Command="{x:Bind ViewModel.SignInWithCodeCommand, Mode=OneTime}"
                    Content="{x:Bind ViewModel.Localizer.Get('Login_CodeLoginForm_Continue')}"
                    Style="{StaticResource PrimaryButtonStyle}" />

        </StackPanel>

    </Grid>

</Page>
