<Page x:Class="SyncVPN.Client.UI.Login.LoginPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:SyncVPN.Client.UI.Login.Components"
      xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pathIcons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="LoginPage"
      AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Automation_Properties_Login_Page')}"
      Background="{ThemeResource BackgroundNormColorBrush}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Page.Resources>

        <!--  Same card language as the Store page (rounded pane-overlay card, 1px border, 16 radius)  -->
        <!--  so signing in feels like part of the app rather than a separate legacy screen.  -->
        <Style x:Key="LoginCardStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="{ThemeResource PaneOverlayBackgroundColorBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource PaneOverlayBorderColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="LoginFeatureCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource PaneOverlayBackgroundColorBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource PaneOverlayBorderColorBrush}" />
        </Style>

        <Style x:Key="LoginFeatureBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource VpnGreenWeakColorBrush}" />
        </Style>

        <Style x:Key="LoginFeatureImageStyle" TargetType="Image">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Page.Resources>

    <Grid>

        <!--  Soft brand-green wash behind the top of the page, fading into the normal background.  -->
        <Grid Height="420"
              VerticalAlignment="Top"
              Background="{ThemeResource GradientProtectedColorBrush}"
              Opacity="0.85" />

        <Grid Margin="32"
              ColumnSpacing="40">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sign-in card  -->
            <ContentControl Grid.Column="0"
                            Width="440"
                            Padding="32,28"
                            Style="{StaticResource LoginCardStyle}">

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0"
                           Height="40"
                           HorizontalAlignment="Left"
                           Source="{ThemeResource ProductLogoIllustrationSource}"
                           Stretch="Uniform" />

                    <Frame x:Name="LoginNavigationFrame"
                           Grid.Row="1"
                           IsNavigationStackEnabled="{x:Bind Navigator.IsNavigationStackEnabled}" />

                    <StackPanel Grid.Row="1"
                                Margin="-12,0"
                                VerticalAlignment="Top"
                                Spacing="12">

                        <components:DisableKillSwitchBannerComponent />

                        <InfoBar AutomationProperties.AutomationId="LoginPageMessage"
                                 CornerRadius="12"
                                 IsOpen="{x:Bind ViewModel.IsMessageVisible, Mode=TwoWay}"
                                 Message="{x:Bind ViewModel.Message}"
                                 Severity="{x:Bind ViewModel.MessageSeverity, Converter={StaticResource SeverityToInfoBarSeverityConverter}}">
                            <InfoBar.ActionButton>
                                <custom:GhostButton Name="ActionButton"
                                                    AutomationProperties.AutomationId="ActionButton"
                                                    AutomationProperties.Name="{x:Bind ViewModel.ActionButtonTitle}"
                                                    Command="{x:Bind ViewModel.TriggerActionButtonCommand, Mode=OneTime}"
                                                    Content="{x:Bind ViewModel.ActionButtonTitle}"
                                                    Style="{StaticResource PrimaryGhostButtonStyle}"
                                                    Visibility="{x:Bind ViewModel.ActionButtonTitle, Converter={StaticResource StringVisibilityConverter}}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                    </StackPanel>

                    <custom:GhostButton Grid.Row="2"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="HelpButton"
                                        Content="{x:Bind ViewModel.Localizer.Get('SignIn_Form_Help')}"
                                        Style="{ThemeResource PrimaryGhostButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsHelpVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <custom:GhostButton.Flyout>
                            <MenuFlyout AutomationProperties.AutomationId="HelpFlyoutMenu"
                                        ShouldConstrainToRootBounds="True">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ResetPasswordCommand, Mode=OneTime}"
                                                Style="{StaticResource HyperlinkMenuFlyoutItemStyle}"
                                                Text="{x:Bind ViewModel.Localizer.Get('SignIn_Form_ResetPassword')}">
                                    <MenuFlyoutItem.Icon>
                                        <pathIcons:Key />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ForgotUsernameCommand, Mode=OneTime}"
                                                Style="{StaticResource HyperlinkMenuFlyoutItemStyle}"
                                                Text="{x:Bind ViewModel.Localizer.Get('SignIn_Form_ForgotUsername')}">
                                    <MenuFlyoutItem.Icon>
                                        <pathIcons:User />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.TroubleSigningInCommand, Mode=OneTime}"
                                                Style="{StaticResource HyperlinkMenuFlyoutItemStyle}"
                                                Text="{x:Bind ViewModel.Localizer.Get('SignIn_Form_TroubleSigningIn')}">
                                    <MenuFlyoutItem.Icon>
                                        <pathIcons:LifeRing />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem AutomationProperties.AutomationId="ReportIssueMenuItem"
                                                Command="{x:Bind ViewModel.ReportAnIssueCommand}"
                                                Text="{x:Bind ViewModel.Localizer.Get('SignIn_Form_ReportAnIssue')}">
                                    <MenuFlyoutItem.Icon>
                                        <pathIcons:Bug />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShowDebugToolsCommand, Mode=OneTime}"
                                                Text="Debug tools"
                                                Visibility="{x:Bind ViewModel.IsDebugModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <pathIcons:WindowTerminal />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </custom:GhostButton.Flyout>
                        <custom:GhostButton.RightIcon>
                            <pathIcons:QuestionCircle />
                        </custom:GhostButton.RightIcon>
                    </custom:GhostButton>
                </Grid>
            </ContentControl>

            <!--  Hero: illustration, headline and feature cards  -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="24">

                    <Image MaxHeight="260"
                           HorizontalAlignment="Center"
                           Source="{StaticResource GlobeIllustrationSource}"
                           Stretch="Uniform" />

                    <StackPanel Spacing="8">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Localizer.Get('SignIn_Form_BestSecureVpnForSpeed')}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Localizer.Get('SignIn_Hero_Subtitle')}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="12">

                        <Border Style="{StaticResource LoginFeatureCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LoginFeatureBadgeStyle}">
                                    <Image Source="{ThemeResource EncryptedLockIllustrationSource}"
                                           Style="{StaticResource LoginFeatureImageStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind ViewModel.Localizer.Get('SignIn_Feature_Encryption_Title')}" />
                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="{x:Bind ViewModel.Localizer.Get('SignIn_Feature_Encryption_Description')}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LoginFeatureCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LoginFeatureBadgeStyle}">
                                    <Image Source="{ThemeResource SpeedUpsellSmallIllustrationSource}"
                                           Style="{StaticResource LoginFeatureImageStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind ViewModel.Localizer.Get('SignIn_Feature_Speed_Title')}" />
                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="{x:Bind ViewModel.Localizer.Get('SignIn_Feature_Speed_Description')}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LoginFeatureCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LoginFeatureBadgeStyle}">
                                    <Image Source="{StaticResource CertifiedNoLogsIllustrationSource}"
                                           Style="{StaticResource LoginFeatureImageStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind ViewModel.Localizer.Get('SignIn_Form_NoLogsPolicy')}" />
                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="{x:Bind ViewModel.Localizer.Get('SignIn_Feature_NoLogs_Description')}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
