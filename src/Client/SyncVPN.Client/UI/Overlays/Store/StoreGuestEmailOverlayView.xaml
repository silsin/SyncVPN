<custom:MessageContentDialog x:Class="SyncVPN.Client.UI.Overlays.Store.StoreGuestEmailOverlayView"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             x:DefaultBindMode="OneWay"
                             Title="{x:Bind ViewModel.Title}"
                             CloseButtonText="{x:Bind ViewModel.Localizer.Get('Common_Actions_Cancel')}"
                             IsPrimaryButtonEnabled="{x:Bind ViewModel.IsEmailValid}"
                             PrimaryButtonText="{x:Bind ViewModel.Localizer.Get('Store_GuestEmail_Continue')}"
                             Style="{StaticResource MessageContentDialogStyle}"
                             mc:Ignorable="d">

    <custom:MessageContentDialog.Resources>
        <x:Double x:Key="ContentDialogWidth">420</x:Double>
        <x:Double x:Key="MaximumContentDialogWidth">420.0</x:Double>
    </custom:MessageContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                   Text="{x:Bind ViewModel.Description}"
                   TextWrapping="Wrap" />
        <TextBox x:Name="EmailTextBox"
                 AutomationProperties.AutomationId="StoreGuestEmailTextBox"
                 Header="{x:Bind ViewModel.Localizer.Get('Store_GuestEmail_FieldLabel')}"
                 InputScope="EmailSmtpAddress"
                 PlaceholderText="{x:Bind ViewModel.Localizer.Get('Store_GuestEmail_Placeholder')}"
                 Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</custom:MessageContentDialog>
