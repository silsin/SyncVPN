<Page x:Class="SyncVPN.Client.UI.Main.Settings.SettingsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pathIcons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="SettingsPage"
      AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Automation_Properties_Settings_Page')}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <ContentControl HorizontalAlignment="Stretch"
                    IsTabStop="False"
                    IsHitTestVisible="{x:Bind IsHitTestVisible}"
                    Style="{StaticResource PaneContentControlStyle}"
                    Padding="0">

        <Frame x:Name="SettingsNavigationFrame"
               TabFocusNavigation="Cycle"
               VerticalAlignment="Stretch"
               IsNavigationStackEnabled="{x:Bind Navigator.IsNavigationStackEnabled}" />

    </ContentControl>
</Page>