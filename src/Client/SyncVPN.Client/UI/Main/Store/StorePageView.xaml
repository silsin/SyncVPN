<Page x:Class="SyncVPN.Client.UI.Main.Store.StorePageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:aprop="using:SyncVPN.Client.Common.UI.AttachedProperties"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pathicons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
      xmlns:selectors="using:SyncVPN.Client.Selectors"
      xmlns:store="using:SyncVPN.Client.UI.Main.Store"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="StorePage"
      AutomationProperties.Name="{x:Bind ViewModel.Title}"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundNormColorBrush}"
      mc:Ignorable="d">

    <Page.Resources>

        <!--  Vertical pricing-card shape (was a full-width horizontal row) - same corner radius/spacing  -->
        <!--  scale as the rest of the app, just composed top-to-bottom instead of left-to-right. A fixed  -->
        <!--  Width/Height keeps every card (and the CTA at its bottom) the same size regardless of how  -->
        <!--  much optional content (devices row, recommended pill) a given card actually has.  -->
        <x:Double x:Key="StorePlanCardWidth">252.0</x:Double>
        <x:Double x:Key="StorePlanCardHeight">412.0</x:Double>

        <Style x:Key="StorePlanCardBaseStyle" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource StorePlanCardWidth}" />
            <Setter Property="Height" Value="{StaticResource StorePlanCardHeight}" />
            <Setter Property="Padding" Value="24,28,24,24" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--  Real illustrated artwork (the same set used for upsell/feature badges elsewhere) instead of  -->
        <!--  flat line icons - soft brand-green wash behind it so all three badges read as one family.  -->
        <Style x:Key="StorePlanIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource VpnGreenWeakColorBrush}" />
        </Style>

        <Style x:Key="StorePlanIconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StorePillBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StorePlanNameTextStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="StorePlanPriceTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StoreRecommendedButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource VpnGreenColorBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="StoreDefaultButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!--  A plan that is neither the user's current plan nor the recommended (longest-cycle) one.  -->
        <DataTemplate x:Key="DefaultPlanCardTemplate" x:DataType="store:StorePlanItem">
            <Border Background="{ThemeResource PaneOverlayBackgroundColorBrush}"
                    BorderBrush="{ThemeResource PaneOverlayBorderColorBrush}"
                    BorderThickness="1"
                    Style="{StaticResource StorePlanCardBaseStyle}">

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="proxyDefault"
                            aprop:AncestorSource.AncestorType="ItemsControl" />

                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Top"
                                Spacing="16">
                        <Border Style="{StaticResource StorePlanIconBadgeStyle}">
                            <Image Source="{ThemeResource EncryptedLockIllustrationSource}"
                                   Style="{StaticResource StorePlanIconImageStyle}" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource StorePlanNameTextStyle}"
                                       Text="{x:Bind Name, Mode=OneTime}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind BillingCycleDisplay, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource StorePlanPriceTextStyle}"
                                   Text="{x:Bind PriceDisplay, Mode=OneTime}" />

                        <StackPanel HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{x:Bind HasDevicesInfo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                            <pathicons:CheckmarkCircleFilled Foreground="{ThemeResource VpnGreenColorBrush}"
                                                             Size="Pixels16" />
                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind DevicesText, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="1"
                            AutomationProperties.AutomationId="StorePlanUpgradeButton"
                            Command="{Binding DataContext.DataContext.UpgradeCommand, ElementName=proxyDefault}"
                            CommandParameter="{x:Bind Mode=OneTime}"
                            Content="{x:Bind UpgradeButtonText, Mode=OneTime}"
                            IsEnabled="{Binding DataContext.DataContext.IsProcessingCheckout, ElementName=proxyDefault, Converter={StaticResource NotBooleanToBooleanConverter}}"
                            Style="{StaticResource StoreDefaultButtonStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  The best-value plan (longest billing cycle) - filled green card, same size as its siblings;  -->
        <!--  emphasis comes from the fill/thicker border/pill badge alone, not a size or position trick.  -->
        <DataTemplate x:Key="RecommendedPlanCardTemplate" x:DataType="store:StorePlanItem">
            <Border Background="{ThemeResource VpnGreenWeakColorBrush}"
                    BorderBrush="{ThemeResource VpnGreenColorBrush}"
                    BorderThickness="2"
                    Style="{StaticResource StorePlanCardBaseStyle}">

                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="proxyRecommended"
                            aprop:AncestorSource.AncestorType="ItemsControl" />

                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Top"
                                Spacing="14">
                        <Border Background="{ThemeResource VpnGreenColorBrush}"
                                Style="{StaticResource StorePillBadgeStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <pathicons:StarFilled Foreground="White"
                                                      Size="Pixels16" />
                                <TextBlock FontWeight="Bold"
                                           Foreground="White"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind RecommendedBadgeText, Mode=OneTime}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StorePlanIconBadgeStyle}">
                            <Image Source="{ThemeResource SpeedUpsellSmallIllustrationSource}"
                                   Style="{StaticResource StorePlanIconImageStyle}" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource StorePlanNameTextStyle}"
                                       Text="{x:Bind Name, Mode=OneTime}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind BillingCycleDisplay, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource StorePlanPriceTextStyle}"
                                   Text="{x:Bind PriceDisplay, Mode=OneTime}" />

                        <StackPanel HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{x:Bind HasDevicesInfo, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                            <pathicons:CheckmarkCircleFilled Foreground="{ThemeResource VpnGreenColorBrush}"
                                                             Size="Pixels16" />
                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind DevicesText, Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="1"
                            AutomationProperties.AutomationId="StorePlanUpgradeButton"
                            Command="{Binding DataContext.DataContext.UpgradeCommand, ElementName=proxyRecommended}"
                            CommandParameter="{x:Bind Mode=OneTime}"
                            Content="{x:Bind UpgradeButtonText, Mode=OneTime}"
                            IsEnabled="{Binding DataContext.DataContext.IsProcessingCheckout, ElementName=proxyRecommended, Converter={StaticResource NotBooleanToBooleanConverter}}"
                            Style="{StaticResource StoreRecommendedButtonStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  The plan the user is already on - outlined, with a "Your plan" pill instead of a CTA.  -->
        <DataTemplate x:Key="CurrentPlanCardTemplate" x:DataType="store:StorePlanItem">
            <Border Background="{ThemeResource PaneOverlayBackgroundColorBrush}"
                    BorderBrush="{ThemeResource VpnGreenColorBrush}"
                    BorderThickness="1"
                    Style="{StaticResource StorePlanCardBaseStyle}">

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Top"
                                Spacing="16">
                        <Border Style="{StaticResource StorePlanIconBadgeStyle}">
                            <Image Source="{ThemeResource CertifiedNoLogsIllustrationSource}"
                                   Style="{StaticResource StorePlanIconImageStyle}" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource StorePlanNameTextStyle}"
                                       Text="{x:Bind Name, Mode=OneTime}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind BillingCycleDisplay, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource StorePlanPriceTextStyle}"
                                   Text="{x:Bind PriceDisplay, Mode=OneTime}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{ThemeResource VpnGreenWeakColorBrush}"
                            BorderBrush="{ThemeResource VpnGreenColorBrush}"
                            BorderThickness="1"
                            Style="{StaticResource StorePillBadgeStyle}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <pathicons:CheckmarkCircleFilled Foreground="{ThemeResource VpnGreenColorBrush}"
                                                             Size="Pixels16" />
                            <TextBlock FontWeight="Bold"
                                       Foreground="{ThemeResource VpnGreenColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind CurrentPlanBadgeText, Mode=OneTime}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:StorePlanCardTemplateSelector x:Key="StorePlanCardTemplateSelector"
                                                 CurrentPlanTemplate="{StaticResource CurrentPlanCardTemplate}"
                                                 DefaultPlanTemplate="{StaticResource DefaultPlanCardTemplate}"
                                                 RecommendedPlanTemplate="{StaticResource RecommendedPlanCardTemplate}" />
    </Page.Resources>

    <Grid Margin="32,28"
          RowSpacing="4">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12">
            <Border Width="40"
                    Height="40"
                    Background="{ThemeResource VpnGreenWeakColorBrush}"
                    CornerRadius="10">
                <pathicons:BagPercentFilled Foreground="{ThemeResource VpnGreenColorBrush}"
                                            Size="Pixels20" />
            </Border>
            <TextBlock VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.Title}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="{ThemeResource TextWeakColorBrush}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Text="{x:Bind ViewModel.Localizer.Get('Store_Page_Subtitle')}" />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,20"
                    Orientation="Horizontal"
                    Spacing="8">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextWeakColorBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind ViewModel.Localizer.Get('Store_CurrentPlan_Label')}" />
            <Border Background="{ThemeResource VpnGreenWeakColorBrush}"
                    BorderBrush="{ThemeResource VpnGreenColorBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,1">
                <TextBlock FontWeight="Bold"
                           Foreground="{ThemeResource VpnGreenColorBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.CurrentPlanLabel}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">

            <ProgressRing HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsLoading}"
                          Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="{x:Bind ViewModel.LoadErrorMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryLoadPlansCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Store_LoadError_RetryButton')}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource NotBooleanToVisibilityConverter}}">
                <ItemsControl HorizontalAlignment="Center"
                              ItemTemplateSelector="{StaticResource StorePlanCardTemplateSelector}"
                              DataContext="{x:Bind ViewModel}"
                              ItemsSource="{x:Bind ViewModel.Plans}"
                              TabFocusNavigation="Cycle">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel HorizontalAlignment="Center"
                                                HorizontalSpacing="16"
                                                Orientation="Horizontal"
                                                VerticalSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
