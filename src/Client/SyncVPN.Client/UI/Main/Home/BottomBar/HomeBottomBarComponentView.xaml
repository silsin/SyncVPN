<UserControl x:Class="SyncVPN.Client.UI.Main.Home.BottomBar.HomeBottomBarComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathicons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
             x:DefaultBindMode="OneWay"
             AutomationProperties.AutomationId="HomeBottomBarComponent"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="HomeBottomCardTitleStyle" BasedOn="{StaticResource BodyMediumStrongTextBlockStyle}" TargetType="TextBlock" />

        <Style x:Key="HomeBottomCardDescriptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextWeakColorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="16"
          VerticalAlignment="Bottom">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Fastest server - Stretch (overriding PaneContentControlStyle's default Left) so this card grows  -->
        <!--  and shrinks with the bar's own width instead of just hugging its content.  -->
        <ContentControl Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PaneContentControlStyle}">
            <Grid ColumnSpacing="12"
                  Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource InteractionDefaultColorBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                    <pathicons:BoltFilled HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{ThemeResource VpnGreenColorBrush}"
                                         Size="Pixels20" />
                </Border>

                <StackPanel Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HomeBottomCardTitleStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Server_Fastest')}" />
                    <TextBlock Style="{StaticResource HomeBottomCardDescriptionStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Home_FastestServer_Description')}"
                               Visibility="{x:Bind ViewModel.IsConnecting, Converter={StaticResource NotBooleanToVisibilityConverter}}" />
                    <TextBlock Style="{StaticResource HomeBottomCardDescriptionStyle}"
                               AutomationProperties.AutomationId="HomeFastestServerConnectingStatusText"
                               Text="{x:Bind ViewModel.ConnectingStatusText}"
                               Visibility="{x:Bind ViewModel.IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomeFastestServerConnectButton"
                        Command="{x:Bind ViewModel.ConnectCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Connect')}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowConnectButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomeFastestServerEnableServiceButton"
                        Command="{x:Bind ViewModel.EnableServiceCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Enable')}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowEnableServiceButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomeFastestServerCancelButton"
                        Command="{x:Bind ViewModel.CancelConnectionCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Cancel')}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowCancelButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </ContentControl>

        <!--  Pick country - same Stretch treatment as Fastest server above.  -->
        <ContentControl Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PaneContentControlStyle}">
            <Grid ColumnSpacing="12"
                  Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource InteractionDefaultColorBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                    <pathicons:Globe HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{ThemeResource TextNormColorBrush}"
                                     Size="Pixels20" />
                </Border>

                <StackPanel Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HomeBottomCardTitleStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Home_PickCountry_Title')}" />
                    <TextBlock Style="{StaticResource HomeBottomCardDescriptionStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Home_PickCountry_Description')}" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomePickCountryOpenButton"
                        Command="{x:Bind ViewModel.OpenCountriesCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Open')}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </ContentControl>

    </Grid>

</UserControl>
