<UserControl x:Class="SyncVPN.Client.UI.Main.Home.BottomBar.HomeBottomBarComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="using:SyncVPN.Client.UI.Main.Home.Card.DefaultConnections"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathicons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
             x:DefaultBindMode="OneWay"
             AutomationProperties.AutomationId="HomeBottomBarComponent"
             mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="QuickConnectFlagWidth">28.0</x:Double>
        <x:Double x:Key="QuickConnectFlagHeight">20.0</x:Double>

        <Style x:Key="QuickConnectChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource PaneOverlayBackgroundColorBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource PaneOverlayBorderColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="8,8,16,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="HomeBottomCardTitleStyle" BasedOn="{StaticResource BodyMediumStrongTextBlockStyle}" TargetType="TextBlock" />

        <Style x:Key="HomeBottomCardDescriptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextWeakColorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="16"
          VerticalAlignment="Bottom">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Quick Connect  -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Spacing="6">

            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextWeakColorBrush}"
                           Text="{x:Bind ViewModel.Localizer.Get('Home_QuickConnect_Label')}" />
                <pathicons:ChevronDownFilled Size="Pixels16"
                                             Foreground="{ThemeResource TextWeakColorBrush}" />
            </StackPanel>

            <Grid>
                <Button x:Name="QuickConnectConnectButton"
                        AutomationProperties.AutomationId="HomeQuickConnectConnectButton"
                        Command="{x:Bind ViewModel.ConnectCommand, Mode=OneTime}"
                        IsEnabledChanged="OnButtonIsEnabledChanged"
                        Style="{StaticResource QuickConnectChipButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <custom:ComplexCountryFlag Grid.Column="0"
                                                   Width="{StaticResource QuickConnectFlagWidth}"
                                                   Height="{StaticResource QuickConnectFlagHeight}"
                                                   VerticalAlignment="Center"
                                                   EntryCountryCode="{x:Bind ViewModel.EntryCountry}"
                                                   ExitCountryCode="{x:Bind ViewModel.ExitCountry}"
                                                   IsCompact="True"
                                                   IsSecureCore="{x:Bind ViewModel.IsSecureCore}"
                                                   MainFlagType="{x:Bind ViewModel.FlagType}"
                                                   Visibility="{x:Bind ViewModel.IsProfileIntent, Converter={StaticResource NotBooleanToVisibilityConverter}}" />

                        <custom:ConnectionProfileIcon Grid.Column="0"
                                                      Width="{StaticResource QuickConnectFlagWidth}"
                                                      Height="{StaticResource QuickConnectFlagHeight}"
                                                      CountryCode="{x:Bind ViewModel.ExitCountry}"
                                                      FlagType="{x:Bind ViewModel.FlagType}"
                                                      IsCompact="True"
                                                      IsFlagVisible="True"
                                                      ProfileCategory="{x:Bind ViewModel.Profile.Icon.Category}"
                                                      ProfileColor="{x:Bind ViewModel.Profile.Icon.Color}"
                                                      Visibility="{x:Bind ViewModel.IsProfileIntent, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Title}"
                                   TextTrimming="CharacterEllipsis" />

                        <dc:DefaultConnectionSelectorView Grid.Column="2"
                                                          VerticalAlignment="Center"
                                                          ToolTipService.ToolTip="{x:Bind ViewModel.Localizer.Get('Home_ConnectionCard_ChangeDefaultConnection')}"
                                                          Visibility="{x:Bind ViewModel.IsChangeDefaultConnectionOptionVisible}" />
                    </Grid>
                </Button>

                <Button x:Name="QuickConnectCancelButton"
                        AutomationProperties.AutomationId="HomeQuickConnectCancelButton"
                        Command="{x:Bind ViewModel.CancelConnectionCommand, Mode=OneTime}"
                        IsEnabledChanged="OnButtonIsEnabledChanged"
                        Style="{StaticResource QuickConnectChipButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <custom:ComplexCountryFlag Width="{StaticResource QuickConnectFlagWidth}"
                                                   Height="{StaticResource QuickConnectFlagHeight}"
                                                   VerticalAlignment="Center"
                                                   EntryCountryCode="{x:Bind ViewModel.EntryCountry}"
                                                   ExitCountryCode="{x:Bind ViewModel.ExitCountry}"
                                                   IsCompact="True"
                                                   IsSecureCore="{x:Bind ViewModel.IsSecureCore}"
                                                   MainFlagType="{x:Bind ViewModel.FlagType}" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Localizer.Get('Common_Actions_Cancel')}" />
                    </StackPanel>
                </Button>

                <Button x:Name="QuickConnectDisconnectButton"
                        AutomationProperties.AutomationId="HomeQuickConnectDisconnectButton"
                        Command="{x:Bind ViewModel.DisconnectCommand, Mode=OneTime}"
                        IsEnabledChanged="OnButtonIsEnabledChanged"
                        Style="{StaticResource QuickConnectChipButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <custom:ComplexCountryFlag Width="{StaticResource QuickConnectFlagWidth}"
                                                   Height="{StaticResource QuickConnectFlagHeight}"
                                                   VerticalAlignment="Center"
                                                   EntryCountryCode="{x:Bind ViewModel.EntryCountry}"
                                                   ExitCountryCode="{x:Bind ViewModel.ExitCountry}"
                                                   IsCompact="True"
                                                   IsSecureCore="{x:Bind ViewModel.IsSecureCore}"
                                                   MainFlagType="{x:Bind ViewModel.FlagType}" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Localizer.Get('Common_Actions_Disconnect')}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!--  Fastest server  -->
        <ContentControl Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PaneContentControlStyle}">
            <Grid ColumnSpacing="12"
                  Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource InteractionDefaultColorBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                    <pathicons:BoltFilled HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{ThemeResource VpnGreenColorBrush}"
                                         Size="Pixels20" />
                </Border>

                <StackPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           MaxWidth="150">
                    <TextBlock Style="{StaticResource HomeBottomCardTitleStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Server_Fastest')}" />
                    <TextBlock Style="{StaticResource HomeBottomCardDescriptionStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Home_FastestServer_Description')}" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomeFastestServerConnectButton"
                        Command="{x:Bind ViewModel.ConnectCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Connect')}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </ContentControl>

        <!--  Pick country  -->
        <ContentControl Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PaneContentControlStyle}">
            <Grid ColumnSpacing="12"
                  Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource InteractionDefaultColorBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                    <pathicons:Globe HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{ThemeResource TextNormColorBrush}"
                                     Size="Pixels20" />
                </Border>

                <StackPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           MaxWidth="150">
                    <TextBlock Style="{StaticResource HomeBottomCardTitleStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Home_PickCountry_Title')}" />
                    <TextBlock Style="{StaticResource HomeBottomCardDescriptionStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Home_PickCountry_Description')}" />
                </StackPanel>

                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HomePickCountryOpenButton"
                        Command="{x:Bind ViewModel.OpenCountriesCommand, Mode=OneTime}"
                        Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Open')}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </ContentControl>

    </Grid>

</UserControl>
