<UserControl x:Class="SyncVPN.Client.UI.Main.Home.HomeComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:banners="using:SyncVPN.Client.UI.Main.Components.Banners"
             xmlns:bottombar="using:SyncVPN.Client.UI.Main.Home.BottomBar"
             xmlns:components="using:SyncVPN.Client.UI.Main.Components"
             xmlns:connection="using:SyncVPN.Client.UI.Main.Home.Details.Connection"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:details="using:SyncVPN.Client.UI.Main.Home.Details"
             xmlns:freeservers="using:SyncVPN.Client.UI.Main.Home.FreeServers"
             xmlns:local="using:SyncVPN.Client.UI.Main.Home"
             xmlns:map="using:SyncVPN.Client.UI.Main.Map"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:status="using:SyncVPN.Client.UI.Main.Home.Status"
             xmlns:update="using:SyncVPN.Client.UI.Update"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="ConnectionStatusGradientHeight">332.0</x:Double>
        <x:Double x:Key="ConnectionDetailsGradientHeight">264.0</x:Double>

        <x:Double x:Key="FadeInOpacity">1</x:Double>
        <x:Double x:Key="FadeOutOpacity">0.4</x:Double>

        <x:Double x:Key="FreeServersSectionWidth">380.0</x:Double>

        <Duration x:Key="OpacityAnimationDuration">0:0:5</Duration>
    </UserControl.Resources>

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="{x:Bind SidebarWidth, Converter={StaticResource DoubleToPixelGridLengthConverter}}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={StaticResource MainTitleBarHeight}, Converter={StaticResource DoubleToPixelGridLengthConverter}}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"
                           MinHeight="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <map:MapComponentView x:Name="MapView"
                              IsTabStop="False"
                              Grid.RowSpan="6"
                              Grid.ColumnSpan="4"
                              BottomOffset="{x:Bind MapBottomOffset}"
                              LeftOffset="{x:Bind SidebarWidth}"
                              RightOffset="{StaticResource FreeServersSectionWidth}"
                              TopOffset="{x:Bind MapTopOffset}" />

        <!--  Opaque backdrop behind the (transparent, content-blended) OS title bar row,  -->
        <!--  so it reads as a flat, solid dark bar instead of showing the map through it.  -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Background="{ThemeResource BackgroundNormColorBrush}"
                IsHitTestVisible="False" />

        <status:ConnectionStatusGradientView Grid.Row="1"
                                             Grid.RowSpan="3"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="4"
                                             IsTabStop="False"
                                             Height="{StaticResource ConnectionStatusGradientHeight}"
                                             VerticalAlignment="Top"
                                             IsHitTestVisible="False" />

        <!--  Connection details background  -->
        <Border Grid.Row="1"
                Grid.RowSpan="3"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Height="{StaticResource ConnectionDetailsGradientHeight}"
                VerticalAlignment="Bottom"
                Background="{ThemeResource ReverseGradientFadingColorBrush}"
                IsHitTestVisible="False" />

        <!--  Persistent Connect card, always visible at the top of the map. Placed here rather than inside  -->
        <!--  MapComponentView itself so it renders after (on top of) the opaque title-bar backdrop and  -->
        <!--  status gradient above, which would otherwise cover it.  -->
        <Border x:Name="MapConnectButtonContainer"
               Grid.Row="1"
               Grid.Column="2"
               Margin="0,16,0,0"
               Padding="20,16"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               BorderBrush="{ThemeResource PaneOverlayBorderColorBrush}"
               BorderThickness="1"
               CornerRadius="16"
               Visibility="{x:Bind ConnectionCardComponent.ViewModel.ShowMapConnectCard, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!--  A plain low-alpha fill rather than AcrylicBrush (used elsewhere in the app for this same  -->
            <!--  "glass panel" look) - Acrylic's live blur depends on DWM compositor support that isn't  -->
            <!--  available in every environment (e.g. some Remote Desktop sessions), where it silently  -->
            <!--  falls back to a fully opaque FallbackColor instead of blurring. A semi-transparent solid  -->
            <!--  color has no such fallback - it always shows the map through it.  -->
            <Border.Background>
                <SolidColorBrush Opacity="0.18" Color="{ThemeResource BackgroundNormColor}" />
            </Border.Background>


            <StackPanel HorizontalAlignment="Center"
                       Spacing="12">

                <!--  A pin tap (MapView.ViewModel.SelectedCountry, set in MapComponentView.xaml.cs) or picking  -->
                <!--  a server from the Free servers list (MapLocationSelectedMessage, see  -->
                <!--  MapComponentViewModel) both feed MapView.ViewModel.SelectedCountry - name it here above  -->
                <!--  the button, taking priority over the default/Cancel/Disconnect group below.  -->
                <StackPanel HorizontalAlignment="Center"
                           Spacing="2"
                           Visibility="{x:Bind MapView.ViewModel.HasSelectedCountry, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextWeakColorBrush}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Text="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Map_SelectedLocation_Label')}" />
                    <TextBlock MaxWidth="260"
                              HorizontalAlignment="Center"
                              Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                              Text="{x:Bind MapView.ViewModel.SelectedCountry.Name}"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="NoWrap" />
                </StackPanel>

                <Button x:Name="MapSelectedConnectButton"
                        MinWidth="220"
                        AutomationProperties.AutomationId="MapSelectedConnectButton"
                        Command="{x:Bind MapView.ViewModel.ConnectCommand, Mode=OneTime}"
                        CommandParameter="{x:Bind MapView.ViewModel.SelectedCountry}"
                        Content="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Common_Actions_Connect')}"
                        IsEnabled="{x:Bind MapView.ViewModel.CanConnectFromMap}"
                        Style="{StaticResource LargePrimaryButtonStyle}"
                        Visibility="{x:Bind MapView.ViewModel.ShowSelectedConnectButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Spacing="12"
                           Visibility="{x:Bind MapView.ViewModel.HasSelectedCountry, Converter={StaticResource NotBooleanToVisibilityConverter}}">

                    <!--  Only meaningful while actually disconnected - once connecting/connected the buttons  -->
                    <!--  below already make the state obvious, so this would just be redundant clutter.  -->
                    <TextBlock HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextWeakColorBrush}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Text="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Map_PleaseSelectServer_Label')}"
                              Visibility="{x:Bind ConnectionCardComponent.ViewModel.CanSelectServer, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!--  Once Connect is pressed, MapView.ViewModel.SelectedCountry (and so the name block  -->
                    <!--  above) is deliberately cleared - without this, the panel dropped straight from  -->
                    <!--  showing the server name to a bare Cancel/Disconnect button with no name anywhere,  -->
                    <!--  which read as the server having been forgotten mid-connect. ConnectionCardComponent's  -->
                    <!--  own Title already resolves correctly for Connecting/Connected (see  -->
                    <!--  GetConnectionIntentTitle/GetConnectionDetailsTitle), so it's the reliable source here.  -->
                    <StackPanel HorizontalAlignment="Center"
                               Spacing="2"
                               Visibility="{x:Bind ConnectionCardComponent.ViewModel.IsDisconnected, Converter={StaticResource NotBooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextWeakColorBrush}"
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Text="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Map_SelectedLocation_Label')}" />
                        <TextBlock MaxWidth="260"
                                  HorizontalAlignment="Center"
                                  Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                                  Text="{x:Bind ConnectionCardComponent.ViewModel.Title}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="NoWrap" />
                    </StackPanel>

                    <Grid>
                        <Button x:Name="MapDefaultConnectButton"
                                MinWidth="220"
                                AutomationProperties.AutomationId="MapDefaultConnectButton"
                                Command="{x:Bind MapView.ViewModel.ConnectCommand, Mode=OneTime}"
                                Content="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Common_Actions_Connect')}"
                                IsEnabled="{x:Bind MapView.ViewModel.CanConnectFromMap}"
                                Style="{StaticResource LargePrimaryButtonStyle}"
                                Visibility="{x:Bind MapView.ViewModel.ShowConnectButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button x:Name="MapCancelConnectionButton"
                                MinWidth="220"
                                AutomationProperties.AutomationId="MapCancelConnectionButton"
                                Command="{x:Bind ConnectionCardComponent.ViewModel.CancelConnectionCommand, Mode=OneTime}"
                                Content="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Common_Actions_Cancel')}"
                                Style="{StaticResource LargePrimaryButtonStyle}"
                                Visibility="{x:Bind MapView.ViewModel.ShowCancelButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button x:Name="MapDisconnectButton"
                                MinWidth="220"
                                AutomationProperties.AutomationId="MapDisconnectButton"
                                Command="{x:Bind ConnectionCardComponent.ViewModel.DisconnectCommand, Mode=OneTime}"
                                Content="{x:Bind ConnectionCardComponent.ViewModel.Localizer.Get('Common_Actions_Disconnect')}"
                                Style="{StaticResource LargePrimaryButtonStyle}"
                                Visibility="{x:Bind ConnectionCardComponent.ViewModel.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Banner + bottom bar container background  -->
        <Border Grid.Row="4"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Background="{ThemeResource ReverseStrongGradientFadingColorBrush}"
                IsHitTestVisible="False" />

        <Grid Grid.Row="1"
              Grid.RowSpan="5"
              Grid.Column="3"
              Margin="0,16,16,16"
              RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <freeservers:HomeFreeServersSectionView x:Name="HomeFreeServersSection"
                                                    Grid.Row="0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />

            <details:DetailsComponentView x:Name="DetailsComponent"
                                          Grid.Row="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
        </Grid>

        <!--  Column 2 only (not spanning into column 1, the sidebar's own column) - Quick Connect/Fastest  -->
        <!--  server/Pick country must never start inside the sidebar's column span, or their left portion  -->
        <!--  renders behind the sidebar's own opaque panel instead of being clipped by it cleanly.  -->
        <bottombar:HomeBottomBarComponentView x:Name="ConnectionCardComponent"
                                              Grid.Row="5"
                                              Grid.Column="2"
                                              Margin="8,0,8,16"
                                              HorizontalAlignment="Stretch" />

        <components:ConnectionErrorComponent x:Name="ConnectionErrorComponent"
                                             Grid.Row="1"
                                             Grid.RowSpan="4"
                                             Grid.Column="2"
                                             MaxWidth="{StaticResource MaximumHomePageContentWidth}"
                                             Margin="0,1,0,0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top" />

        <StackPanel x:Name="BannersContainer"
                    Grid.Row="4"
                    Grid.Column="2"
                    MaxWidth="{StaticResource MaximumHomePageContentWidth}"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch">

            <banners:ProminentBannerComponent HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" />

            <ContentControl Margin="0,8,0,0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            IsHitTestVisible="{x:Bind IsHitTestVisible}"
                            Style="{StaticResource PaneContentControlStyle}"
                            Visibility="{x:Bind ViewModel.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">

                <update:UpdateComponent Title="{x:Bind ViewModel.Localizer.Get('Components_Update_UpdateAvailable')}"
                                        Margin="8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Description="{x:Bind ViewModel.Localizer.Get('Components_Update_GetMostFromYourVpn')}"
                                        IsImageVisible="True" />
            </ContentControl>

        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NavigationStates">
                <VisualState x:Name="OnHomePage">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsHomeDisplayed}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionCardComponent.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="HomeFreeServersSection.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="ConnectionErrorComponent.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="MapView.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="MapConnectButtonContainer.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="DetailsComponent.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="BannersContainer.Opacity" Value="{StaticResource FadeInOpacity}" />
                        <Setter Target="DetailsComponent.IsEnabled" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NotOnHomePage">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionCardComponent.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="HomeFreeServersSection.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="ConnectionErrorComponent.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="MapView.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="MapConnectButtonContainer.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="DetailsComponent.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="BannersContainer.Opacity" Value="{StaticResource FadeOutOpacity}" />
                        <Setter Target="DetailsComponent.IsEnabled" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</UserControl>