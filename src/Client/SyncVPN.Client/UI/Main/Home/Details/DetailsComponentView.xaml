<UserControl x:Class="SyncVPN.Client.UI.Main.Home.Details.DetailsComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathIcons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
             xmlns:status="using:SyncVPN.Client.UI.Main.Home.Status"
             xmlns:icons="using:SyncVPN.Client.Common.UI.Assets.Icons"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ContentControl Padding="12"
                    IsTabStop="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource TranslucentPaneContentControlStyle}">

        <Grid RowSpacing="12"
              VerticalAlignment="Top">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <status:ConnectionStatusHeaderView Grid.Row="0"
                                               Margin="10,4,10,0"
                                               UseSimplifiedVersion="True" />

            <Frame x:Name="DetailsNavigationFrame"
                   Grid.Row="1"
                   IsNavigationStackEnabled="{x:Bind Navigator.IsNavigationStackEnabled}" />
        </Grid>

    </ContentControl>

</UserControl>