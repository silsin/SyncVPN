<UserControl x:Class="SyncVPN.Client.UI.Main.Home.Details.Flyouts.FreeServersFlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:flyouts="using:SyncVPN.Client.UI.Main.Home.Details.Flyouts"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="320"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource InfoFlyoutContentSpacing}">

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                   Text="{x:Bind ViewModel.Localizer.Get('Flyouts_FreeServers_Title')}" />

        <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                   Text="{x:Bind ViewModel.Localizer.Get('Flyouts_FreeServers_Description')}" />

        <ProgressRing Width="20"
                      Height="20"
                      HorizontalAlignment="Left"
                      IsActive="{x:Bind ViewModel.IsLoading}"
                      Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Foreground="{ThemeResource SignalDangerColor}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Text="{x:Bind ViewModel.Localizer.Get('Flyouts_FreeServers_Error')}"
                   Visibility="{x:Bind ViewModel.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                   Text="{x:Bind ViewModel.Localizer.Get('Flyouts_FreeServers_Empty')}"
                   Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Visibility="{x:Bind ViewModel.HasServers, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="280">
                <ListView x:Name="ServersListView"
                          IsItemClickEnabled="True"
                          ItemClick="OnServerClicked"
                          ItemsSource="{x:Bind ViewModel.Servers}"
                          SelectionMode="None">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="flyouts:FreeServerItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Top"
                                           Text="{x:Bind CountryEmoji}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}">
                                        <Run Text="{x:Bind CountryName}" />
                                        <Run Text="—" />
                                        <Run Text="{x:Bind City}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind ProtocolsText}" />
                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind Datacenter}" />
                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind CoordinatesText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

    </StackPanel>

</UserControl>
