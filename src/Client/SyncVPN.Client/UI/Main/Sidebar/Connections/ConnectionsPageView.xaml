<Page x:Class="SyncVPN.Client.UI.Main.Sidebar.Connections.ConnectionsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:SyncVPN.Client.UI.Main.Sidebar.Connections"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="ConnectionsPage"
      AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Automation_Properties_Sidebar_Connections_Page')}"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundNormColorBrush}"
      mc:Ignorable="d">

    <Grid Background="{ThemeResource BackgroundNormColorBrush}">

        <Frame x:Name="ConnectionsNavigationFrame"
               IsNavigationStackEnabled="{x:Bind Navigator.IsNavigationStackEnabled}" />

    </Grid>

</Page>