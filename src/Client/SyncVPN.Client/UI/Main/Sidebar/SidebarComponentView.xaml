<UserControl x:Class="SyncVPN.Client.UI.Main.Sidebar.SidebarComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathicons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
             x:DefaultBindMode="OneWay"
             AutomationProperties.AutomationId="SidebarComponent"
             AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('Automation_Properties_Sidebar')}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="SidebarNavItemIconSize">16</x:Double>
        <Thickness x:Key="SidebarNavItemPadding">10,6</Thickness>

        <Style x:Key="SidebarSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,8" />
            <Setter Property="Background" Value="{ThemeResource BorderWeakColorBrush}" />
        </Style>

        <SolidColorBrush x:Key="SidebarSelectedItemBackgroundBrush" Color="{ThemeResource VpnGreenColor}" Opacity="0.12" />

        <Style x:Key="SidebarSelectedItemBackgroundStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedItemBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7,12,12,7" />
        </Style>

        <Style x:Key="SidebarUnselectedItemBackgroundStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TransparentColorBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7,12,12,7" />
        </Style>

        <!--  "FREE" tag on feature rows (Secure Core, NetShield)  -->
        <Style x:Key="SidebarFreeBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#332563EB" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="SidebarFreeBadgeTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#60A5FA" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  "FREE" plan badge under the logo  -->
        <Style x:Key="SidebarPlanBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource VpnGreenWeakColorBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource VpnGreenColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
        </Style>

        <Style x:Key="SidebarPlanBadgeTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource VpnGreenColorBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SidebarUpgradeButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource VpnGreenWeakColorBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource VpnGreenColorBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource VpnGreenColorBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Resources>

    <Border Width="230"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="{ThemeResource BackgroundNormColorBrush}"
            Padding="12,16">

        <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Logo + plan  -->
            <StackPanel Grid.Row="0"
                        Margin="8,8,8,20"
                        Orientation="Horizontal"
                        Spacing="10">
                <pathicons:ShieldFilled Foreground="{ThemeResource VpnGreenColorBrush}"
                                        Size="Pixels24" />
                <StackPanel VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                               Text="SyncVPN" />
                    <Border HorizontalAlignment="Left"
                            Style="{StaticResource SidebarPlanBadgeStyle}">
                        <TextBlock Style="{StaticResource SidebarPlanBadgeTextStyle}"
                                   Text="{x:Bind ViewModel.PlanLabel}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!--  Navigation items  -->
            <StackPanel Grid.Row="1"
                        Spacing="4">

                <!--  Home  -->
                <Grid>
                    <Border Style="{StaticResource SidebarSelectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsHomeSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Style="{StaticResource SidebarUnselectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsHomeSelected, Converter={StaticResource NotBooleanToVisibilityConverter}}" />
                    <custom:GhostButton HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="{StaticResource SidebarNavItemPadding}"
                                        AutomationProperties.AutomationId="SidebarNavItemHome"
                                        Command="{x:Bind ViewModel.NavigateHomeCommand, Mode=OneTime}"
                                        Content="{x:Bind ViewModel.Localizer.Get('Home_NavItem_Title')}"
                                        Foreground="{x:Bind ViewModel.IsHomeSelected, Converter={StaticResource BooleanToVpnGreenForegroundConverter}}">
                        <custom:GhostButton.LeftIcon>
                            <pathicons:House Size="Pixels16" />
                        </custom:GhostButton.LeftIcon>
                    </custom:GhostButton>
                </Grid>

                <!--  Countries  -->
                <Grid>
                    <Border Style="{StaticResource SidebarSelectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsCountriesSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Style="{StaticResource SidebarUnselectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsCountriesSelected, Converter={StaticResource NotBooleanToVisibilityConverter}}" />
                    <custom:GhostButton HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="{StaticResource SidebarNavItemPadding}"
                                        AutomationProperties.AutomationId="SidebarNavItemCountries"
                                        Command="{x:Bind ViewModel.NavigateCountriesCommand, Mode=OneTime}"
                                        Content="{x:Bind ViewModel.Localizer.Get('Countries')}"
                                        Foreground="{x:Bind ViewModel.IsCountriesSelected, Converter={StaticResource BooleanToVpnGreenForegroundConverter}}">
                        <custom:GhostButton.LeftIcon>
                            <pathicons:Earth Size="Pixels16" />
                        </custom:GhostButton.LeftIcon>
                    </custom:GhostButton>
                </Grid>

                <Border Style="{StaticResource SidebarSeparatorStyle}" />

                <!--  Secure Core  -->
                <Grid>
                    <Border Style="{StaticResource SidebarSelectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsSecureCoreSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Style="{StaticResource SidebarUnselectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsSecureCoreSelected, Converter={StaticResource NotBooleanToVisibilityConverter}}" />
                    <custom:GhostButton HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="{StaticResource SidebarNavItemPadding}"
                                        AutomationProperties.AutomationId="SidebarNavItemSecureCore"
                                        Command="{x:Bind ViewModel.NavigateSecureCoreCommand, Mode=OneTime}"
                                        Foreground="{x:Bind ViewModel.IsSecureCoreSelected, Converter={StaticResource BooleanToVpnGreenForegroundConverter}}">
                        <custom:GhostButton.LeftIcon>
                            <pathicons:Shield2 Size="Pixels16" />
                        </custom:GhostButton.LeftIcon>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.Localizer.Get('Countries_SecureCore')}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SidebarFreeBadgeStyle}">
                                <TextBlock Style="{StaticResource SidebarFreeBadgeTextStyle}"
                                           Text="{x:Bind ViewModel.Localizer.Get('Sidebar_FreePlanBadge')}" />
                            </Border>
                        </Grid>
                    </custom:GhostButton>
                </Grid>

                <!--  NetShield  -->
                <Grid>
                    <Border Style="{StaticResource SidebarSelectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsNetShieldSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Style="{StaticResource SidebarUnselectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsNetShieldSelected, Converter={StaticResource NotBooleanToVisibilityConverter}}" />
                    <custom:GhostButton HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="{StaticResource SidebarNavItemPadding}"
                                        AutomationProperties.AutomationId="SidebarNavItemNetShield"
                                        Command="{x:Bind ViewModel.NavigateNetShieldCommand, Mode=OneTime}"
                                        Foreground="{x:Bind ViewModel.IsNetShieldSelected, Converter={StaticResource BooleanToVpnGreenForegroundConverter}}">
                        <custom:GhostButton.LeftIcon>
                            <pathicons:Shield2Bolt Size="Pixels16" />
                        </custom:GhostButton.LeftIcon>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.Localizer.Get('Settings_Connection_NetShield')}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SidebarFreeBadgeStyle}">
                                <TextBlock Style="{StaticResource SidebarFreeBadgeTextStyle}"
                                           Text="{x:Bind ViewModel.Localizer.Get('Sidebar_FreePlanBadge')}" />
                            </Border>
                        </Grid>
                    </custom:GhostButton>
                </Grid>

                <Border Style="{StaticResource SidebarSeparatorStyle}" />

                <!--  Settings  -->
                <Grid>
                    <Border Style="{StaticResource SidebarSelectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Style="{StaticResource SidebarUnselectedItemBackgroundStyle}"
                            Visibility="{x:Bind ViewModel.IsSettingsSelected, Converter={StaticResource NotBooleanToVisibilityConverter}}" />
                    <custom:GhostButton HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="{StaticResource SidebarNavItemPadding}"
                                        AutomationProperties.AutomationId="SidebarNavItemSettings"
                                        Command="{x:Bind ViewModel.NavigateSettingsCommand, Mode=OneTime}"
                                        Content="{x:Bind ViewModel.Localizer.Get('Settings_Page_Title')}"
                                        Foreground="{x:Bind ViewModel.IsSettingsSelected, Converter={StaticResource BooleanToVpnGreenForegroundConverter}}">
                        <custom:GhostButton.LeftIcon>
                            <pathicons:CogWheel Size="Pixels16" />
                        </custom:GhostButton.LeftIcon>
                    </custom:GhostButton>
                </Grid>

            </StackPanel>

            <!--  Free plan card  -->
            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="12"
                    Background="{ThemeResource PaneOverlayBackgroundColorBrush}"
                    BorderBrush="{ThemeResource PaneOverlayBorderColorBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsFreePlan, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Sidebar_FreePlanCard_Title')}" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextWeakColorBrush}"
                               Text="{x:Bind ViewModel.Localizer.Get('Sidebar_FreePlanCard_DailyData')}" />

                    <TextBlock Style="{StaticResource BodyMediumStrongTextBlockStyle}"
                               Foreground="{ThemeResource VpnGreenColorBrush}"
                               Text="{x:Bind ViewModel.DailyDataUsageText}" />

                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="SidebarUpgradeToPremiumButton"
                            Command="{x:Bind ViewModel.UpgradeToPremiumCommand, Mode=OneTime}"
                            Style="{StaticResource SidebarUpgradeButtonStyle}">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <pathicons:Rocket Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Size="Pixels16" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.Localizer.Get('Sidebar_FreePlanCard_Upgrade')}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

</UserControl>
