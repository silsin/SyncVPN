<UserControl x:Class="SyncVPN.Client.UI.Main.FeatureIcons.PortForwardingIconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:SyncVPN.Client.UI.Main.FeatureIcons"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathIcons="using:SyncVPN.Client.Common.UI.Assets.Icons.PathIcons"
             xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">
    <Grid>
        <custom:DimmableImage IconSource="{x:Bind ViewModel.Icon}"
                              IsDimmed="{x:Bind ViewModel.IsDimmed}" 
                              Width="{x:Bind Width}"
                              Height="{x:Bind Height}"/>

        <pathIcons:ExclamationTriangleFilled Margin="0,-8,-8,0"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Foreground="{ThemeResource SignalWarningColorBrush}"
                                             Size="Pixels16"
                                             Visibility="{x:Bind ViewModel.IsConnectedWithPortForwardingError, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>