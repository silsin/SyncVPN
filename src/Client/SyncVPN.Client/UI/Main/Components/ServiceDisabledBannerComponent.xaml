<UserControl x:Class="SyncVPN.Client.UI.Main.Components.ServiceDisabledBannerComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:custom="using:SyncVPN.Client.Common.UI.Controls.Custom"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <InfoBar Title="{x:Bind ViewModel.Localizer.Get('Banner_ServiceDisabled_Title')}"
             AutomationProperties.AutomationId="ServiceDisabledBannerPanel"
             IsClosable="False"
             IsOpen="{x:Bind ViewModel.IsServiceDisabledBannerVisible}"
             Message="{x:Bind ViewModel.Localizer.Get('Banner_ServiceDisabled_Description')}"
             Severity="Warning">
        <InfoBar.ActionButton>
            <custom:GhostButton AutomationProperties.AutomationId="EnableServiceButton"
                                Command="{x:Bind ViewModel.EnableServiceCommand}"
                                Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_Enable')}"
                                Style="{StaticResource PrimaryGhostButtonStyle}" />
        </InfoBar.ActionButton>
    </InfoBar>
</UserControl>
