            <Color x:Key="TextOnPrimaryColor">#051521</Color>
            <!--  Background (Disconnected: Background/Border/Text/Hover)  -->
            <Color x:Key="BackgroundNormColor">#0D2231</Color>
            <Color x:Key="BackgroundWeakColor">#122D3D</Color>
            <Color x:Key="BackgroundStrongColor">#1C3040</Color>
            <Color x:Key="BackgroundInvertColor">#FFFFFF</Color>
            <!--  Border  -->
            <Color x:Key="BorderNormColor">#1C3040</Color>
            <Color x:Key="BorderWeakColor">#1C3040</Color>
            <Color x:Key="BorderFocusColor">#22C55E</Color>
            <Color x:Key="BorderFocusRingColor">#4D22C55E</Color>
            <!--  Map  -->
            <Color x:Key="MapNormColor">#1C3040</Color>
            <Color x:Key="MapHighlightColor">#2F5270</Color>
            <!--  Signal (VPN status: Connected / Connecting / Disconnected / Error)  -->
            <Color x:Key="SignalDangerColor">#EF4444</Color>
            <Color x:Key="SignalWarningColor">#F59E0B</Color>
            <Color x:Key="SignalSuccessColor">#22C55E</Color>
            <Color x:Key="SignalNeutralColor">#71808F</Color>
            <!--  Backdrop  -->
            <Color x:Key="BackdropNormColor">#7A000000</Color>
            <!--  VPN  -->
            <Color x:Key="VpnGreenColor">#22C55E</Color>
            <!--  Gradient  -->
            <Color x:Key="GradientFadingStartColor">#FF0D2231</Color>
            <Color x:Key="GradientFadingMiddleColor">#F00D2231</Color>
            <Color x:Key="GradientFadingEndColor">#000D2231</Color>
            <Color x:Key="GradientUnprotectedStartColor">#8071808F</Color>
            <Color x:Key="GradientUnprotectedEndColor">#0071808F</Color>
            <Color x:Key="GradientConnectingStartColor">#80F59E0B</Color>
            <Color x:Key="GradientConnectingEndColor">#00F59E0B</Color>
            <Color x:Key="GradientProtectedStartColor">#8022C55E</Color>
            <Color x:Key="GradientProtectedEndColor">#0022C55E</Color>
            <Color x:Key="GradientWarningStartColor">#80F59E0B</Color>
            <Color x:Key="GradientWarningEndColor">#00F59E0B</Color>
            <Color x:Key="GradientConnectionLineStartColor">#22C55E</Color>
            <Color x:Key="GradientConnectionLineEndColor">#16A34A</Color>
            <Color x:Key="GradientDisconnectedPinStop1Color">#0071808F</Color>
            <Color x:Key="GradientDisconnectedPinStop2Color">#8071808F</Color>
            <Color x:Key="GradientDisconnectedPinStop3Color">#FF71808F</Color>
            <Color x:Key="GradientConnectedPinStop1Color">#0022C55E</Color>
            <Color x:Key="GradientConnectedPinStop2Color">#8022C55E</Color>
            <Color x:Key="GradientConnectedPinStop3Color">#FF22C55E</Color>
            <Color x:Key="GradientUpsellBackgroundStartColor">#FF11D8CC</Color>
            <Color x:Key="GradientUpsellBackgroundEndColor">#006E4BFF</Color>
            <Color x:Key="GradientDownloadSpeedChartStartColor">#4022C55E</Color>
            <Color x:Key="GradientDownloadSpeedChartEndColor">#0022C55E</Color>
            <Color x:Key="GradientUploadSpeedChartStartColor">#40EF4444</Color>
            <Color x:Key="GradientUploadSpeedChartEndColor">#00EF4444</Color>

            <!--  Composite Colors  -->

            <!--  BackgroundNormColor + InteractionDefaultHoverColor  -->
            <Color x:Key="BackgroundNormHoverColor">#263946</Color>
            <!--  BackgroundNormColor + InteractionDefaultActiveColor  -->
            <Color x:Key="BackgroundNormActiveColor">#3D4E5A</Color>

            <!--  BackgroundWeakColor + InteractionDefaultHoverColor  -->
            <Color x:Key="BackgroundWeakHoverColor">#2A4251</Color>
            <!--  BackgroundWeakColor + InteractionDefaultActiveColor  -->
            <Color x:Key="BackgroundWeakActiveColor">#415764</Color>

            <!--  BackgroundStrongColor + InteractionDefaultHoverColor  -->
            <Color x:Key="BackgroundStrongHoverColor">#334554</Color>
            <!--  BackgroundStrongColor + InteractionDefaultActiveColor  -->
            <Color x:Key="BackgroundStrongActiveColor">#495966</Color>

            <!--  InteractionWeakHoverColor + SignalDangerColor (40%)  -->
            <Color x:Key="InteractionWeakDangerHoverColor">#764251</Color>
            <!--  InteractionWeakActiveColor + SignalDangerColor (40%)  -->
            <Color x:Key="InteractionWeakDangerActiveColor">#7D4A59</Color>

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>