            <Color x:Key="BackgroundWeakHoverColor">#E3E2E1</Color>
            <!--  BackgroundWeakColor + InteractionDefaultActiveColor  -->
            <Color x:Key="BackgroundWeakActiveColor">#D8D7D7</Color>

            <!--  BackgroundStrongColor + InteractionDefaultHoverColor  -->
            <Color x:Key="BackgroundStrongHoverColor">#D4D3D1</Color>
            <!--  BackgroundStrongColor + InteractionDefaultActiveColor  -->
            <Color x:Key="BackgroundStrongActiveColor">#CAC9C8</Color>

            <!--  InteractionWeakHoverColor + SignalDangerColor (20%)  -->
            <Color x:Key="InteractionWeakDangerHoverColor">#E1C1C7</Color>
            <!--  InteractionWeakActiveColor + SignalDangerColor (20%)  -->
            <Color x:Key="InteractionWeakDangerActiveColor">#D1B1B8</Color>

        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">

            <!--  Colors  -->

            <!--  Primary  -->
            <Color x:Key="PrimaryColor">#22C55E</Color>
            <!--  Link  -->
            <Color x:Key="LinkNormColor">#22C55E</Color>
            <Color x:Key="LinkHoverColor">#34D875</Color>
            <Color x:Key="LinkActiveColor">#16A34A</Color>
            <!--  InteractionNorm (Connected: Background/Hover/Pressed)  -->
            <Color x:Key="InteractionNormColor">#22C55E</Color>
            <Color x:Key="InteractionNormHoverColor">#34D875</Color>
            <Color x:Key="InteractionNormActiveColor">#16A34A</Color>
            <!--  InteractionWeak  -->
            <Color x:Key="InteractionWeakColor">#1C3040</Color>
            <Color x:Key="InteractionWeakHoverColor">#25415A</Color>
            <Color x:Key="InteractionWeakActiveColor">#2F5270</Color>
            <!--  InteractionDefault  -->
            <Color x:Key="InteractionDefaultEmptyColor">#00FFFFFF</Color>
            <Color x:Key="InteractionDefaultColor">#0DFFFFFF</Color>
            <Color x:Key="InteractionDefaultHoverColor">#1AFFFFFF</Color>
            <Color x:Key="InteractionDefaultActiveColor">#33FFFFFF</Color>
            <!--  InteractionException  -->
            <Color x:Key="InteractionExceptionColor">#1C3040</Color>
            <Color x:Key="InteractionExceptionHoverColor">#25415A</Color>
            <Color x:Key="InteractionExceptionActiveColor">#2F5270</Color>
            <!--  Text  -->
            <Color x:Key="TextNormColor">#FFF5F7FA</Color>
            <Color x:Key="TextWeakColor">#B3F5F7FA</Color>
            <Color x:Key="TextHintColor">#80F5F7FA</Color>
            <Color x:Key="TextDisabledColor">#4DF5F7FA</Color>
            <Color x:Key="TextInvertColor">#0D2231</Color>
