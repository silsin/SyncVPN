            <Color x:Key="InteractionWeakHoverColor">#ECECEC</Color>
            <Color x:Key="InteractionWeakActiveColor">#D8D8D9</Color>
            <!--  InteractionDefault  -->
            <Color x:Key="InteractionDefaultEmptyColor">#000C0C14</Color>
            <Color x:Key="InteractionDefaultColor">#0A0C0C14</Color>
            <Color x:Key="InteractionDefaultHoverColor">#140C0C14</Color>
            <Color x:Key="InteractionDefaultActiveColor">#1F0C0C14</Color>
            <!--  InteractionException  -->
            <Color x:Key="InteractionExceptionColor">#FFFFFF</Color>
